{
  "name": "attention-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset": "supabase db reset",
    "db:reset:local": "tsx scripts/db-local.ts reset",
    "db:types": "supabase gen types typescript --local --schema public > src/data/supabase/database.types.ts",
    "db:types:local": "tsx scripts/gen-types-local.ts > src/data/supabase/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@supabase/postgres-meta": "^0.99.0",
    "@supabase/postgrest-typegen": "^0.2.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.0.0",
    "pg": "^8.16.0",
    "prettier": "^3.6.0",
    "supabase": "^2.116.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
